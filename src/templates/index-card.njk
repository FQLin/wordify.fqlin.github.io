<article class="family-card reveal" id="family-{{ slug }}">
  <div class="family-mark">{{ rootName }}</div>
  <h2>{{ title }}</h2>
  <p class="family-subtitle">{{ subtitle }}</p>
  <div class="family-meta-list">{{ metaList }}</div>
  <div class="family-word-links">
    <p class="family-word-label">{{ wordLinksLabel }}</p>
    <div class="word-link-list">{{ wordLinks }}</div>
  </div>
  <a class="family-link" href="./{{ slug }}.html">{{ viewTopic }}</a>
</article>

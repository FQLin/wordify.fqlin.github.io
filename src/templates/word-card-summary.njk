<header class="word-card-header flow-block flow-block-summary">
  <div class="word-card-head">
    <span class="word-index">{{ wordIndex }}</span>
    <div class="word-card-headcopy">
      <h2 class="word-title" id="{{ titleId }}">{{ wordText }}</h2>
      <div class="word-levels">{{ levelChips }}</div>
    </div>
  </div>
</header>
